{
  "name": "@di-framework/ai-utils",
  "version": "6.0.0",
  "description": "Agentic utilities for @di-framework/ai \u2014 Agent Skills, file/shell tools, todos, memory, and subagents",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "author": "@di-framework Contributors",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/ai",
    "directory": "ai-utils"
  },
  "bugs": {
    "url": "https://github.com/di-framework/ai/issues"
  },
  "homepage": "https://github.com/di-framework/ai",
  "keywords": [
    "ai",
    "llm",
    "agent-skills",
    "skills",
    "spring-ai",
    "di-framework"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node --external @di-framework/ai --external @di-framework/core && tsc --emitDeclarationOnly --declaration --outDir dist",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@di-framework/core": "^5",
    "@di-framework/repo": "^5",
    "@huggingface/transformers": "4.2.0",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@di-framework/ai": "^6",
    "@di-framework/core": "^5",
    "@di-framework/repo": "^5",
    "@huggingface/transformers": "4.2.0",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "@di-framework/repo": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
